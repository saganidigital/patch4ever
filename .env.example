# Server-side Admin Authentication (Required for /admin login)
# Generate ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET by running:
#   node scripts/hash-password.mjs "YourStrongPasswordHere"
ADMIN_EMAIL=admin@patch4ever.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Supabase PostgreSQL Database (Server-side only — never expose SERVICE_ROLE_KEY to the browser)
# Find both in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
